# ========================================================
# CryptoWhale AI Pro - Trading Bot & Terminal Environment Config
# ========================================================

# Server Network Configuration
PORT=3000
NODE_ENV=production
DISABLE_HMR=true

# Google Gemini API Key (Required for AI Copilot & Quant Insights)
GEMINI_API_KEY=your_gemini_api_key_here

# Binance Futures API Credentials (Optional for Paper Trading; Required for Live Real-Order Execution)
# Obtain from: Binance.com > Profile > API Management > Enable Futures
BINANCE_API_KEY=your_binance_futures_api_key_here
BINANCE_API_SECRET=your_binance_futures_api_secret_here
BINANCE_USE_TESTNET=false

# Telegram Bot Alert Dispatcher (Instant notifications to iPhone 15 / Telegram)
# Create bot via @BotFather and get chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Webhook Endpoint (Discord, Slack, or Custom Webhooks)
WEBHOOK_URL=

# Quantitative Risk Management Guardrails (Prop Firm Strict Rules)
MAX_DAILY_DRAWDOWN_PERCENT=4.0
MAX_TOTAL_DRAWDOWN_PERCENT=8.0
MAX_RISK_PER_TRADE_PERCENT=2.0
MAX_LEVERAGE=20
MAX_SLIPPAGE_PERCENT=0.25
